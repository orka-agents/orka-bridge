# Inputs for the Bridge VM image. Every download below is pinned to a checksum or digest;
# the Debian packages (docker.io, docker-cli) come from the signed Debian archive unpinned.
# Bump these together in one change; the build refuses anything that does not match.

# Orka, installed from its release chart. The chart checksum and image digests are read
# from the release's candidate.json, which is pinned here.
ORKA_VERSION=v0.2.0
ORKA_CANDIDATE_SHA256=e13f1b4fe3f5b10bdd94d3356d6ce99f1d7e1d45fa3a80755ae8ec5705c50a1f

# kmx targets exactly one Orka release (`kmx version`). The build checks that it matches
# ORKA_VERSION, so the kmx in the image recognizes the Orka install as its own.
KMX_VERSION=v0.9.0-rc.6
KMX_LINUX_AMD64_SHA256=eac5a27ef4ee1bd980264931adafd80b0e207ea84bde5be8a63e1d83e6e59b66

# Base OS: Debian 13 generic cloud image (cloud-init is used once at build time).
DEBIAN_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/20261103-2651/debian-13-genericcloud-amd64-20261103-2651.qcow2
DEBIAN_IMAGE_SHA512=d25999de0770d4cde1be72c299ba3ad94eac7ea8fd4d18f8cc86c69df69337e2e8a91d64465a9bfd8f2a78c566fcbcb0842eacc91c09efdef72d719d9f13b535

# Kubernetes tooling inside the VM.
KIND_VERSION=v0.33.0
KIND_LINUX_AMD64_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KUBECTL_VERSION=v1.36.4
KUBECTL_LINUX_AMD64_SHA256=8b8f088da2dab964f853b38464033b1be15ede2839eca751482357c45abdd05a
HELM_VERSION=v3.22.1
HELM_LINUX_AMD64_SHA256=896cf63684a42a723d61c980369d6e588330927deb13676ca0d85006dd6da0ea
