{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orka-bridge:bridge-image:v2",
  "$comment": "PROVISIONAL: owner acceptance is required before freezing bridge-image/v2. No publication or boot approval. V1 remains at historical baseline 4b810c232c627f2ccb1dd59456a7ddd415d2912d; no upgrade.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicationReady", "imageId", "buildSourceCommit", "stateCompatibilityId", "target", "components", "layout", "artifact", "defaultLaunch", "directBoot"],
  "properties": {
    "schemaVersion": {"const": "bridge-image/v2"},
    "defaultLaunch": {"enum": ["uefi", "linux-direct"]},
    "directBoot": {
      "type": "object", "additionalProperties": false,
      "required": ["kernel", "initrd", "rootSelector", "kernelRelease", "commandLine", "requiredDrivers", "provenance"],
      "properties": {
        "kernel": {"$ref": "#/$defs/kernel"}, "initrd": {"$ref": "#/$defs/initrd"},
        "rootSelector": {
          "type": "object", "additionalProperties": false, "required": ["kind", "value"],
          "properties": {"kind": {"const": "filesystem-uuid"}, "value": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}}
        },
        "kernelRelease": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,96}-(arm64|amd64)$"},
        "commandLine": {"type": "string", "pattern": "^root=UUID=[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12} ro console=(hvc0|ttyS0,115200n8) noresume$"},
        "requiredDrivers": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
          "allOf": [
            {"contains": {"properties": {"name": {"const": "virtio_pci"}}, "required": ["name"]}},
            {"contains": {"properties": {"name": {"const": "virtio_blk"}}, "required": ["name"]}},
            {"contains": {"properties": {"name": {"const": "virtio_console"}}, "required": ["name"]}},
            {"contains": {"properties": {"name": {"const": "virtio_rng"}}, "required": ["name"]}},
            {"contains": {"properties": {"name": {"const": "virtio_net"}}, "required": ["name"]}},
            {"contains": {"properties": {"name": {"const": "ext4"}}, "required": ["name"]}}
          ], "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "builtIn"],
          "properties": {"name": {"enum": ["virtio_pci", "virtio_blk", "virtio_console", "virtio_rng", "virtio_net", "ext4"]}, "builtIn": {"type": "boolean"}}
        }},
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["diskSha256", "bootReceiptSha256", "buildReceiptSha256", "inputSha256", "kernelConfigSha256", "modulesSha256", "endpointSha256", "earlyHookSha256", "buildHookSha256", "extractorSha256", "inspectorSha256", "extractionTools"],
          "properties": {
            "diskSha256": {"$ref": "#/$defs/hex"}, "bootReceiptSha256": {"$ref": "#/$defs/hex"},
            "buildReceiptSha256": {"$ref": "#/$defs/hex"}, "inputSha256": {"$ref": "#/$defs/hex"},
            "kernelConfigSha256": {"$ref": "#/$defs/hex"}, "modulesSha256": {"$ref": "#/$defs/hex"},
            "endpointSha256": {"$ref": "#/$defs/hex"}, "earlyHookSha256": {"$ref": "#/$defs/hex"},
            "buildHookSha256": {"$ref": "#/$defs/hex"}, "extractorSha256": {"$ref": "#/$defs/hex"}, "inspectorSha256": {"$ref": "#/$defs/hex"},
            "extractionTools": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
              "allOf": [
                {"contains": {"properties": {"name": {"const": "guestfish"}}, "required": ["name"]}},
                {"contains": {"properties": {"name": {"const": "unmkinitramfs"}}, "required": ["name"]}},
                {"contains": {"properties": {"name": {"const": "readelf"}}, "required": ["name"]}},
                {"contains": {"properties": {"name": {"const": "dpkg-query"}}, "required": ["name"]}}
              ], "items": {
              "type": "object", "additionalProperties": false, "required": ["name", "version", "executableSha256"],
              "properties": {"name": {"enum": ["guestfish", "unmkinitramfs", "readelf", "dpkg-query"]}, "version": {"$ref": "#/$defs/toolVersion"}, "executableSha256": {"$ref": "#/$defs/hex"}}
            }}
          }
        }
      }
    },
    "publicationReady": {"const": false},
    "imageId": {"allOf": [{"$ref": "#/$defs/id"}, {"not": {"pattern": "\\.\\."}}]},
    "buildSourceCommit": {"$ref": "#/$defs/commit"},
    "stateCompatibilityId": {"$ref": "#/$defs/id"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "architecture", "format", "minimumHostVersion", "minimumAppVersion"],
      "properties": {
        "platform": {"enum": ["macos", "windows"]},
        "architecture": {"enum": ["arm64", "amd64"]},
        "format": {"enum": ["raw", "qcow2"]},
        "minimumHostVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
        "minimumAppVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"}
      }
    },
    "components": {
      "type": "object", "additionalProperties": false,
      "required": ["inputSchemaVersion", "inputIdentity", "canonicalLockSha256", "versionPolicySha256", "orka", "kmxProfileSha256", "kind", "kubernetes", "vekil", "tools"],
      "properties": {
        "inputSchemaVersion": {"enum": ["bridge-guest-inputs/v1", "bridge-guest-inputs/v2"]},
        "inputIdentity": {"$ref": "#/$defs/hex"},
        "canonicalLockSha256": {"$ref": "#/$defs/hex"},
        "versionPolicySha256": {"$ref": "#/$defs/hex"},
        "orka": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "identity", "sourceCommit", "chartSha256"],
          "properties": {
            "mode": {"enum": ["source", "release"]}, "identity": {"$ref": "#/$defs/version"},
            "sourceCommit": {"$ref": "#/$defs/commit"}, "chartSha256": {"$ref": "#/$defs/hex"}
          }
        },
        "kmxProfileSha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hex"}]},
        "kind": {"$ref": "#/$defs/versionHash"},
        "kubernetes": {
          "type": "object", "additionalProperties": false, "required": ["version", "provenance"],
          "properties": {"version": {"$ref": "#/$defs/version"}, "provenance": {"const": "policy-declared"}}
        },
        "vekil": {
          "type": "object", "additionalProperties": false, "required": ["manifestDigest", "configDigest"],
          "properties": {"manifestDigest": {"$ref": "#/$defs/digest"}, "configDigest": {"$ref": "#/$defs/digest"}}
        },
        "tools": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/tool"}}
      }
    },
    "layout": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "osDisk", "stateDisk", "devices", "transport", "testResources"],
      "properties": {
        "contractVersion": {"const": "H1/v1"},
        "osDisk": {
          "type": "object", "additionalProperties": false,
          "required": ["role", "format", "virtualCapacityBytes", "blockSerial", "partitionTable", "boot", "privateWritableCopy"],
          "properties": {
            "role": {"const": "os-disk"}, "format": {"enum": ["raw", "qcow2"]},
            "virtualCapacityBytes": {"const": 17179869184}, "blockSerial": {"const": "bridge-os"},
            "partitionTable": {"const": "gpt"}, "boot": {"const": "uefi"}, "privateWritableCopy": {"const": true}
          }
        },
        "stateDisk": {
          "description": "Creation descriptor only, never an initialized state payload. Formatting still requires the live host's exclusive new-disk authorization.",
          "type": "object", "additionalProperties": false,
          "required": ["role", "operation", "format", "virtualCapacityBytes", "blockSerial", "filesystem", "partitioning", "formatPolicy"],
          "properties": {
            "role": {"const": "state-disk"}, "operation": {"const": "create-empty"},
            "format": {"enum": ["raw", "qcow2"]}, "virtualCapacityBytes": {"const": 34359738368},
            "blockSerial": {"const": "bridge-state"}, "filesystem": {"const": "ext4"},
            "partitioning": {"const": "whole-device"}, "formatPolicy": {"const": "new-only"}
          }
        },
        "devices": {"const": {"contractVersion": "H1/v1", "diskBus": "virtio", "network": "nat", "entropy": true, "clock": "utc", "controlPort": "ai.orka.bridge.control", "diagnostics": "separate"}},
        "transport": {"const": {"protocolMajor": 1, "framing": "json-lines"}},
        "testResources": {"description": "Engineering settings, not measured host minimums.", "const": {"vcpus": 4, "memoryBytes": 6442450944}}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "format", "compression", "uncompressedBytes", "uncompressedSha256", "compressedBytes", "compressedSha256", "chunks"],
      "properties": {
        "role": {"const": "os-disk"}, "format": {"enum": ["raw", "qcow2"]}, "compression": {"const": "gzip"},
        "uncompressedBytes": {"type": "integer", "minimum": 1}, "uncompressedSha256": {"$ref": "#/$defs/hex"},
        "compressedBytes": {"type": "integer", "minimum": 1}, "compressedSha256": {"$ref": "#/$defs/hex"},
        "chunks": {"type": "array", "minItems": 1, "maxItems": 50000, "items": {"$ref": "#/$defs/chunk"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"target": {"properties": {"platform": {"const": "macos"}}}}},
      "then": {"properties": {
        "target": {"properties": {"architecture": {"const": "arm64"}, "format": {"const": "raw"}}},
        "layout": {"properties": {"osDisk": {"properties": {"format": {"const": "raw"}}}, "stateDisk": {"properties": {"format": {"const": "raw"}}}}},
        "artifact": {"properties": {"format": {"const": "raw"}}},
        "defaultLaunch": {"const": "uefi"},
        "directBoot": {"properties": {
          "kernel": {"properties": {"format": {"const": "linux-arm64-image"}, "name": {"pattern": "-macos-arm64\\.kernel$"}}},
          "initrd": {"properties": {"name": {"pattern": "-macos-arm64\\.initrd$"}}},
          "kernelRelease": {"pattern": "-arm64$"}, "commandLine": {"pattern": " ro console=hvc0 noresume$"}
        }}
      }},
      "else": {"properties": {
        "target": {"properties": {"architecture": {"const": "amd64"}, "format": {"const": "qcow2"}}},
        "layout": {"properties": {"osDisk": {"properties": {"format": {"const": "qcow2"}}}, "stateDisk": {"properties": {"format": {"const": "qcow2"}}}}},
        "artifact": {"properties": {"format": {"const": "qcow2"}}},
        "defaultLaunch": {"const": "linux-direct"},
        "directBoot": {"properties": {
          "kernel": {"properties": {"format": {"const": "linux-bzimage"}, "name": {"pattern": "-windows-amd64\\.kernel$"}}},
          "initrd": {"properties": {"name": {"pattern": "-windows-amd64\\.initrd$"}}},
          "kernelRelease": {"pattern": "-amd64$"}, "commandLine": {"pattern": " ro console=ttyS0,115200n8 noresume$"}
        }}
      }}
    }
  ],
  "$defs": {
    "hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,95}$"},
    "toolVersion": {"type": "string", "minLength": 1, "maxLength": 4096, "allOf": [{"pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]+$"}, {"pattern": "\\S"}]},
    "kernel": {
      "type": "object", "additionalProperties": false, "required": ["name", "bytes", "sha256", "format"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*-(macos-arm64|windows-amd64)\\.kernel$"},
        "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hex"}, "format": {"enum": ["linux-arm64-image", "linux-bzimage"]}
      }
    },
    "initrd": {
      "type": "object", "additionalProperties": false, "required": ["name", "bytes", "sha256", "format", "compression"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*-(macos-arm64|windows-amd64)\\.initrd$"},
        "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hex"}, "format": {"const": "initramfs"},
        "compression": {"enum": ["gzip", "xz", "zstd", "cpio-prefix"]}
      }
    },
    "versionHash": {
      "type": "object", "additionalProperties": false, "required": ["version", "sha256"],
      "properties": {"version": {"$ref": "#/$defs/version"}, "sha256": {"$ref": "#/$defs/hex"}}
    },
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "sha256"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]{0,95}$"}, "version": {"$ref": "#/$defs/toolVersion"}, "sha256": {"$ref": "#/$defs/hex"}}
    },
    "chunk": {
      "type": "object", "additionalProperties": false, "required": ["order", "name", "bytes", "sha256"],
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*-(macos-arm64|windows-amd64)\\.part-[0-9]{6}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}, "sha256": {"$ref": "#/$defs/hex"}
      }
    }
  }
}
