[Unit]
Description=Disposable reference case
Requires=docker.service containerd.service bridge-guest.service
After=docker.service containerd.service bridge-guest.service

[Service]
Type=oneshot
ExecStart=/usr/lib/bridge/reference-check
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0

[Install]
WantedBy=multi-user.target
