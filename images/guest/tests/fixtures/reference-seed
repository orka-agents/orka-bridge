#!/bin/sh
case "$1" in prereqs) echo bridge-state; exit 0;; esac
# Observe the real endpoint after it has completed; never provide boot authority.
set -eu
[ "$rootmnt" = /root ]
modprobe isofs
mkdir -p /run/bridge-seed
mount -t iso9660 -o ro /dev/disk/by-id/virtio-bridge-test /run/bridge-seed
cat /run/bridge-seed/bridge.json > /run/bridge/reference.json
umount /run/bridge-seed
read uptime rest < /proc/uptime
pid1=$(cat /proc/1/comm)
machine=$(cat /root/etc/machine-id)
printf '{"pid1":"%s","machineId":"%s","uptime":%s}\n' "$pid1" "$machine" "$uptime" > /run/bridge/early.json
