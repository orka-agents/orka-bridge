#!/bin/sh
# Reference bootstrap only. Authenticated native descriptor ingestion arrives later.
set -eu
PATH=/usr/lib/bridge:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
root=$1
fail() { trap - EXIT; set +e; echo "BRIDGE_EARLY_ERROR $1" > /dev/console; poweroff -f; while :; do sleep 60; done; }
trap 'fail "state preparation failed"' EXIT
valid_machine_id() {
    jq -en --rawfile machine "$1" '($machine | rtrimstr("\n")) as $id | ($id | length) == 32 and ($id | test("^[0-9a-f]{32}$")) and $id != "00000000000000000000000000000000"' >/dev/null
}
[ -f /run/bridge/reference-test ] || fail 'native creation channel unavailable'
input=/run/bridge/boot.json
jq -e '(.schemaVersion == "bridge-guest-test/v1") and (.caseId == "base") and (.stateSerial == "bridge-state") and (.installationId | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")) and ((.stateCreation == "new") or (.stateCreation == "existing"))' "$input" >/dev/null || fail 'invalid reference descriptor'
id=$(jq -r .installationId "$input")
creation=$(jq -r .stateCreation "$input")
device=/dev/disk/by-id/virtio-bridge-state
for attempt in 1 2 3 4 5; do [ -b "$device" ] && break; sleep 1; done
[ -b "$device" ] || fail 'state disk missing'
[ "$(blockdev --getsize64 "$device")" = 34359738368 ] || fail 'state capacity mismatch'
if blkid -p "$device" > /run/bridge/state-probe; then
    : # A recognized signature must be ext4; GPT or other data isn't blank.
else
    status=$?
    [ "$status" = 2 ] && [ ! -s /run/bridge/state-probe ] || fail 'ambiguous state signature'
    [ "$creation" = new ] || fail 'existing state is unformatted'
    mke2fs -t ext4 -q -U "$id" -E lazy_itable_init=0,lazy_journal_init=0 "$device" || fail 'state format failed'
fi
[ "$(blkid -p -s TYPE -o value "$device")" = ext4 ] || fail 'state filesystem mismatch'
[ "$(blkid -p -s UUID -o value "$device")" = "$id" ] || fail 'state UUID mismatch'
mount -o remount,rw "$root"
state=$root/var/lib/bridge
mkdir -p "$state"
mount -t ext4 "$device" "$state" || fail 'state mount failed'
if [ ! -f "$state/identity.json" ]; then
    [ "$creation" = new ] || fail 'existing identity journal missing'
    jq -n --arg id "$id" '{schemaVersion:"bridge-state/v1",installationId:$id}' > "$state/identity.json.partial"
    sync
    mv "$state/identity.json.partial" "$state/identity.json"
    sync
fi
[ "$(jq -r .installationId "$state/identity.json")" = "$id" ] || fail 'state journal mismatch'
if [ ! -s "$state/machine-id" ]; then
    [ "$creation" = new ] || fail 'existing machine identity missing'
    tr -d '-' < /proc/sys/kernel/random/uuid > "$state/machine-id.partial"
    sync
    mv "$state/machine-id.partial" "$state/machine-id"
    sync
fi
valid_machine_id "$state/machine-id" || fail 'invalid persistent machine identity'
mount --bind "$state/machine-id" "$root/etc/machine-id"
for data in docker containerd; do
    mkdir -p "$state/$data" "$root/var/lib/$data"
    mount --bind "$state/$data" "$root/var/lib/$data"
done
mkdir -p /run/bridge/credentials
mount -t tmpfs -o mode=0700,nosuid,nodev,noexec tmpfs /run/bridge/credentials
pid1=$(cat /proc/1/comm)
time=$(cut -d' ' -f1 /proc/uptime)
jq -n --arg pid1 "$pid1" --arg machine "$(cat "$root/etc/machine-id")" --argjson time "$time" '{pid1:$pid1,machineId:$machine,uptime:$time,credentialsType:"tmpfs"}' > /run/bridge/early.json
sync
trap - EXIT
